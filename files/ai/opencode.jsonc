{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [],
  "permissions": [
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
  ],
  "mcp": {
    "servers": {
      "shadcn": {
        "type": "local",
        "command": [
          "bunx",
          "shadcn@latest",
          "mcp"
        ],
        "disabled": false,
        "protocol": "auto"
      }
    },
  }
}